# ---- Server ----
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500

# PostgreSQL running on Windows, accessed from WSL
PGHOST=172.31.224.1
PGPORT=5432
PGDATABASE=abstract_ecommerce
PGUSER=abstract_app
PGPASSWORD=change-me

# ---- MongoDB (notifications only — everything else stays in Postgres) ----
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=abstract_cosmetics_notifications

# ---- Auth ----
# Long, random strings — e.g. generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# ---- M-Pesa (Safaricom Daraja) ----
# Get these from https://developer.safaricom.co.ke after registering an app.
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-domain.example.com/api/payments/mpesa/callback


#Email configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USER=yourshop@gmail.com
MAIL_PASS=your-16-char-app-password
MAIL_FROM="Abstract Cosmetics <yourshop@gmail.com>"
APP_URL=http://localhost:3000
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com